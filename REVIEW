3. perubahan data cases 
    beri validasi input atau disesuaikan dengan fields, 
    
    const caseId = req.params.id;
    
    const availableFields = ["title","description","status", "priority","requested_by","created_by","assigned_to","updated_at","case_number"];
    
    const incomingFields = Object.keys(req.body);
    const validFields = incomingFields.filter(f => availableFields.includes(f));
    
    if (validFields.length === 0) {
        return res.status(400).json({ error: 'No valid fields to update' });
    }
    
    const sets = validFields.map(f => `${f}=?`).join(', ');
    const values = validFields.map(f => req.body[f]);
    
    const sql = `UPDATE cases SET ${sets} WHERE id = ?`;
    const finalParams = [...values, caseId];
    
    try {
        const result = db.prepare(sql).run(...finalParams);
        res.json({
            success: true,
            message: 'Case updated',
            updatedFields: validFields,
            changes: result.changes
        });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }


